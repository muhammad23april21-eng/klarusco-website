# Copy to .env.local and fill in. Leave blank to show the on-page placeholders.
# WhatsApp number in international format, digits only (e.g. country code + number)
VITE_WHATSAPP_NUMBER=
VITE_CONTACT_EMAIL=
# Public scheduling link (e.g. Calendly, Cal.com, Microsoft Bookings, Google Calendar appointment page)
VITE_BOOKING_URL=
# Optional: endpoint that accepts JSON form posts (e.g. https://formspree.io/f/xxxx). Without it the contact
# form validates input and then offers to send the message by email/WhatsApp instead of claiming it was sent.
VITE_FORM_ENDPOINT=
